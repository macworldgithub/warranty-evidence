# ──────────────────────────────────────────────
# Booran API — Environment Configuration
# ──────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=4000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/booran_warranty?appName=Cluster0

# Supabase Auth (Authentication & Session Management)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Frontend URLs (for CORS)
FRONTEND_WEB_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3000
FRONTEND_OPERATIONS_URL=http://localhost:3001

# Development Seed Credentials (Do not commit real production passwords)
SEED_ADMIN_EMAIL=admin@booran.com
SEED_ADMIN_PASSWORD=Password123!
SEED_OPERATIONS_EMAIL=ops@booran.com
SEED_OPERATIONS_PASSWORD=Password123!
